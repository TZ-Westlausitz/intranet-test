# Vorlage für die lokale .env. Kopieren nach `.env` und Werte anpassen.
# `.env` selbst ist über `.env*` in der .gitignore und darf nie eingecheckt werden.

# Muss zu den Werten aus docker-compose.yml passen (POSTGRES_USER/-PASSWORD/-DB).
DATABASE_URL="postgresql://tpz:entwicklung_nur_lokal@localhost:5432/tpz_intranet"

# Nur relevant, falls das POSTGRES_PASSWORD aus docker-compose.yml per
# Umgebungsvariable überschrieben werden soll. Sonst leer lassen.
# POSTGRES_PASSWORD=

# Wird per `npx auth secret` erzeugt und automatisch eingetragen.
AUTH_SECRET=

# Startpasswort der Seed-Testperson (Benutzername 1001). Ohne diese
# Variable greift der Fallback "start-1234" aus prisma/seed.ts.
SEED_PASSWORT=start-1234

# Startpasswort für alle im Adminbereich neu angelegten bzw.
# zurückgesetzten Zugänge (siehe personErstellen/personPasswortZuruecksetzen).
# Sicher trotz gemeinsamem Passwort, weil danach ein Passwortwechsel
# erzwungen wird (passwortWechselErforderlich, siehe /passwort-aendern).
# Pflichtfeld — ohne diese Variable bricht das Anlegen neuer Benutzer ab.
STANDARD_STARTPASSWORT=

# Wurzelverzeichnis für abgelegte Dateien (PDFs, später Unterschriften,
# Schadensfotos — Regel 7: nur der Pfad steht in der Datenbank). Im
# On-Premise-Betrieb ein gemountetes Volume, siehe README "Sicherung".
# Ohne diese Variable liegt es lokal unter ./storage. Wird ignoriert,
# sobald SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY gesetzt sind (siehe unten).
# ABLAGE_PFAD=./storage

# Nur für den Geräte-Test auf Vercel (siehe README "Testbetrieb"), nicht
# für den lokalen On-Premise-Betrieb. Beide gesetzt → Dateien landen in
# Supabase Storage statt auf der lokalen Festplatte (die ist bei Vercel
# flüchtig). Projekteinstellungen bei Supabase → API.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket-Name in Supabase Storage, muss dort vorher angelegt sein.
# SUPABASE_STORAGE_BUCKET=ablage
