# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example ist eine Vorlage ohne echte Geheimnisse
# (siehe Kommentar dort) und soll ins Repository, damit klar ist, welche
# Variablen gesetzt werden müssen.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (erzeugter Client, entsteht bei jedem `prisma generate` neu)
/src/generated

# hochgeladene/erzeugte Dateien — gehören später aufs Volume bzw. nach
# MinIO (Regel 7), nicht ins Repository. Lokaler Platzhalter fürs Dev.
/storage
